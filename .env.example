# Copy to .env.local. Never commit .env.local.

# ElevenLabs (voice agent): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Filled in for you by `npm run agent:deploy`
ELEVENLABS_AGENT_ID=

# Your deployed site, e.g. https://your-app.vercel.app. The voice agent calls its /api/lookup, so it must be public.
# Needed for `npm run agent:deploy` and `npm run agent:test`.
PUBLIC_URL=

# Optional: another ElevenLabs voice id (the default is the "Emma" voice from the voice library) or LLM
# HIGGSY_VOICE_ID=
# HIGGSY_LLM=gemini-2.5-flash

# ComfyUI, for the in-call demo. Optional: without it Higgsy still works, demos just say they're unavailable.
# Comfy Cloud (paid plan needed for API access): create a key in your Comfy account.
COMFY_API_KEY=
# Or run ComfyUI yourself and point at it instead, e.g. http://127.0.0.1:8188
# COMFY_URL=
# Max demo generations per hour on this server (protects your credits)
# DEMO_MAX_PER_HOUR=20
